---
/**
 * 非中文 500（/en/500/ 等），构建期静态生成。
 */
import ErrorScreen from '@/components/ErrorScreen.astro'
import { LOCALES, type Locale } from '@/config/site'
import { errorPath, errorPathByLocale, getErrorText } from '@/lib/errors'

export function getStaticPaths() {
  return LOCALES.filter((code) => code !== 'zh').map((code) => ({
    params: { locale: code },
    props: { locale: code },
  }))
}

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<ErrorScreen
  locale={locale}
  text={getErrorText(locale, '500')}
  path={errorPath(locale, '500')}
  pathByLocale={errorPathByLocale('500')}
/>