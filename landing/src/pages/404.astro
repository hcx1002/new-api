---
/**
 * 中文 404（/404/）。
 * 其余语言由 [locale]/404.astro 生成；两者共用 ErrorScreen 组件。
 */
import ErrorScreen from '@/components/ErrorScreen.astro'
import { errorPath, errorPathByLocale, getErrorText } from '@/lib/errors'

const locale = 'zh' as const
---

<ErrorScreen
  locale={locale}
  text={getErrorText(locale, '404')}
  path={errorPath(locale, '404')}
  pathByLocale={errorPathByLocale('404')}
/>